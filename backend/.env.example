# RidePulse — Example environment variables (do NOT commit real secrets)

# Application
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-frontend.example.com

# Database
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@cluster0.mongodb.net/ridepulse?retryWrites=true&w=majority

# JWT / Auth
JWT_SECRET=your_jwt_secret_here
EMAIL_VERIFY_SECRET=your_email_verify_secret_here

# Razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# SMTP (for Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user@example.com
SMTP_PASS=supersecretpassword
EMAIL_FROM="RidePulse <noreply@ridepulse.example.com>"

# Twilio (for OTP SMS)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+911234567890

# Redis (BullMQ)
REDIS_URL=redis://:password@redis.example.com:6379

# Nominatim (OpenStreetMap) user-agent
NOMINATIM_USER_AGENT=ridepulse-backend/1.0

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin seeding
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
